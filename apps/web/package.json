{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply hackathonatlas --remote",
    "backfill:thumbnails": "bun scripts/backfill-thumbnails.ts",
    "backfill:locations": "bun scripts/backfill-locations.ts",
    "backfill:devpost-descriptions": "bun scripts/backfill-devpost-descriptions.ts",
    "prune:dead-links": "bun scripts/prune-dead-links.ts",
    "classify:events": "bun scripts/classify-events.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@opennextjs/cloudflare": "1.20.10",
    "@paper-design/shaders-react": "^0.0.71",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@repo/ui": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "openai": "^7.4.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.1",
    "react-grab": "^0.1.23",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "wrangler": "^4.150.0"
  }
}
